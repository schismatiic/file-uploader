<li
    class="relative flex justify-between items-center border border-white/20 p-2 hover:bg-white/10 border-b-0 last:border">
    <a class="flex justify-center min-w-0 flex-col w-full cursor-pointer" href="/folder/<%= id %>/files/<%= fileId %>">
        <div class="flex items-center min-w-0 gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                class="lucide lucide-file shrink-0">
                <path
                    d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" />
                <path d="M14 2v5a1 1 0 0 0 1 1h5" />
            </svg>
            <div class="min-w-0">
                <h3 class="font-extralight truncate">
                    <%= name %>
                </h3>
                <p class="text-xs text-white/70">
                    <%= size %> KB
                </p>
                <p class="text-xs text-white/70">
                    <%= added %>
                </p>
            </div>
        </div>


    </a>
    <button class="menu-button active:scale-90 cursor-pointer ml-2" aria-label="Folder options">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
            class="lucide lucide-ellipsis-vertical">
            <circle cx="12" cy="12" r="1" />
            <circle cx="12" cy="5" r="1" />
            <circle cx="12" cy="19" r="1" />
        </svg>
    </button>
    <div class="absolute flex flex-col items-start right-0 top-full z-10 hidden bg-black border border-white/20 p-2">
        <div class="flex items-center gap-2 active:scale-95 cursor-pointer hover:text-white/90">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                class="lucide lucide-external-link">
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
            <a href="/folder/<%= id %>/files/<%= fileId %>">Open file</a>
        </div>
        <div class="flex items-center gap-2 active:scale-95 cursor-pointer text-red-600 hover:text-red-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                class="lucide lucide-file-x-corner">
                <path
                    d="M11 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v5" />
                <path d="M14 2v5a1 1 0 0 0 1 1h5" />
                <path d="m15 17 5 5" />
                <path d="m20 17-5 5" />
            </svg>
            <a href="/folder/<%= id %>/files/<%= fileId %>/delete">Delete
                file</a>
        </div>
    </div>

</li>