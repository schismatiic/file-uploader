<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Монолит | Rename folder</title>
    <link rel="stylesheet" href="/output.css">
    <link rel="icon" type="image/svg+xml" href="/icons/pyramid.svg">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {user}) %>

        <h3 class="flex justify-center items-center gap-2 mt-4 text-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                class="lucide lucide-folder-pen">
                <path
                    d="M2 11.5V5a2 2 0 0 1 2-2h3.9c.7 0 1.3.3 1.7.9l.8 1.2c.4.6 1 .9 1.7.9H20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-9.5" />
                <path
                    d="M11.378 13.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" />
            </svg>
            <p>Rename folder</p>
        </h3>
        <main class="flex flex-col flex-1 items-center">
            <form action="/folder/rename/<%= id %>" method="POST"
                class="flex flex-col w-full max-w-11/12 md:max-w-5/12 m-4 border border-white/20 p-4 gap-2">
                <label for="name">
                    Name
                </label>
                <input name="name" id="name" class="border border-white/20  px-4 py-2" type="text"
                    placeholder="Folder name" value="<%= name || ''  %>" required>
                <button
                    class="bg-white text-black px-2 py-1 cursor-pointer hover:bg-white/90 active:scale-95 mt-2 w-fit"
                    type="submit">Rename</button>
            </form>
            <% if (locals.errors) {%>
                <ul class="m-4 border border-white/20 p-4 w-fit">
                    <% errors.forEach(function(error) { %>
                        <li class="font-bold">
                            <%= error.msg %>
                        </li>
                        <% }); %>
                </ul>
                <% } %>
        </main>
        <%- include('footer') %>

</body>

</html>