generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model Users {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  username  String    @unique
  email     String    @unique
  password  String
  folders   Folders[]
}

model Folders {
  id      Int     @id @default(autoincrement())
  name    String
  users   Users   @relation(fields: [usersId], references: [id])
  usersId Int
  files   Files[]
}

model Files {
  id        Int      @id @default(autoincrement())
  name      String
  size      Int
  added     DateTime @default(now())
  folders   Folders  @relation(fields: [foldersId], references: [id])
  foldersId Int
}
